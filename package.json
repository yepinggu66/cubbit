{
  "name": "cubbit",
  "productName": "Cubbit",
  "version": "2.9.5",
  "description": "Cubbit 方块仔 — a tiny desktop cube that walks and ground-crawls with context-aware expression scenes.",
  "main": "src/main/main.js",
  "author": {
    "name": "叶永平"
  },
  "license": "SEE LICENSE IN ../../docs/EULA.md",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke:ui": "electron tests/electron-smoke.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:prod": "node scripts/build-prod.js",
    "icon": "node ../scripts/make-icons.mjs",
    "lint": "eslint . --ext .js",
    "obfuscate": "node scripts/obfuscate.js --out ../build-obf"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.9.0",
    "javascript-obfuscator": "^5.9.1"
  },
  "build": {
    "publish": [
      {
        "provider": "generic",
        "url": "https://pingguye.cn/cubbit/dl"
      }
    ],
    "appId": "com.cubbit.desktop",
    "productName": "Cubbit",
    "copyright": "Copyright © 2026 叶永平（个人开发者）",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cubbit-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "unicode": true,
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "方块仔",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Cubbit-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Cubbit-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pubnub": "^13.1.3"
  }
}
